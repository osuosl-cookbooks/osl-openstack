# This file is automatically generated by Chef
# Any changes will be overwritten

[vxlan]
enable_vxlan = true
l2_population = true
local_ip = <%= @local_ip %>

[AGENT]
polling_interval = 2
# Runs from the neutron-agent venv on controllers too, so override neutron.conf
root_helper = sudo <%= @neutron_venv %>/bin/neutron-rootwrap /etc/neutron/rootwrap.conf
root_helper_daemon = sudo <%= @neutron_venv %>/bin/neutron-rootwrap-daemon /etc/neutron/rootwrap.conf

[securitygroup]
enable_security_group = True
firewall_driver = neutron.agent.linux.iptables_firewall.IptablesFirewallDriver

[linux_bridge]
physical_interface_mappings = <%= @physical_interface_mappings.join(',') %>
<%= render 'neutron_privsep.conf.erb', variables: { venv: @neutron_venv } -%>
