# This file is automatically generated by Chef
# Any changes will be overwritten
[DEFAULT]
public_endpoint = https://<%= @endpoint %>:5000/
transport_url = <%= @transport_url %>

[assignment]
driver = sql

[cache]
backend = oslo_cache.memcache_pool
enabled = true
memcache_servers = <%= @memcached_endpoint %>

<%# keystone runs under uWSGI with no eventlet hub to wake between requests,
    so the heartbeat needs a real thread; kolla does the same. -%>
<%= render 'oslo_messaging.conf.erb' -%>

[database]
connection = <%= @database_connection %>

[token]
provider = fernet
