# This file is automatically generated by Chef
# Any changes will be overwritten

[DEFAULT]
transport_url = <%= @transport_url %>

<%= render 'cache.conf.erb' -%>

[notification]
# No event store (panko) is deployed; the default meter,event set would
# fill event.sample with messages nothing consumes.
pipelines = meter

<%# heartbeat_in_pthread defaults to True on yoga: the heartbeat stalls for the
    length of an RPC call, so rabbit drops the connection (LP #2035113). -%>
<%= render 'oslo_messaging.conf.erb' -%>

[service_credentials]
auth_type = v3password
auth_url = https://<%= @auth_endpoint %>:5000/v3
interface = internalURL
password = <%= @service_pass %>
project_domain_name = Default
project_name = service
region_name = <%= @region %>
user_domain_name = Default
username = ceilometer
