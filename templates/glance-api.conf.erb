# This file is automatically generated by Chef
# Any changes will be overwritten

[DEFAULT]
<% if @listen_ip && @listen_ip != '*' -%>
bind_host = <%= @listen_ip %>
<% end -%>
enable_v1_api = false
enable_v2_api = true
<% unless @local_storage -%>
enabled_backends = rbd:rbd
show_image_direct_url = true
show_multiple_locations = true
<% else -%>
enabled_backends = file:file
<% end -%>
transport_url = <%= @transport_url %>

[glance_store]
<% unless @local_storage -%>
default_backend = rbd
default_store = rbd
<% else -%>
default_backend = file
default_store = file
<% end -%>

<% unless @local_storage -%>
[rbd]
rbd_store_ceph_conf = /etc/ceph/ceph.conf
rbd_store_chunk_size = 8
rbd_store_pool = <%= @rbd_store_pool %>
rbd_store_user = <%= @rbd_store_user %>
<% else -%>
[file]
filesystem_store_datadir = /var/lib/glance/images
<% end -%>

[paste_deploy]
flavor = keystone

[keystone_authtoken]
auth_type = password
auth_url = https://<%= @auth_endpoint %>:5000/v3
memcached_servers = <%= @memcached_endpoint %>
password = <%= @service_pass %>
project_domain_name = Default
project_name = service
region_name = RegionOne
service_token_roles = admin
service_token_roles_required = true
user_domain_name = Default
username = glance
www_authenticate_uri = https://<%= @auth_endpoint %>:5000/v3

[oslo_messaging_rabbit]
<%# heartbeat_in_pthread defaults to True on yoga: the heartbeat stalls for the
    length of an RPC call, so rabbit drops the connection (LP #2035113). -%>
heartbeat_in_pthread = false
<% if @rabbit_quorum_queue -%>
rabbit_quorum_queue = true
<% end -%>
<% if @rabbit_tls -%>
ssl = true
<% if @rabbit_ssl_ca_file -%>
ssl_ca_file = <%= @rabbit_ssl_ca_file %>
<% end -%>
<% end -%>

[oslo_messaging_notifications]
driver = messagingv2

[database]
connection = <%= @database_connection %>
