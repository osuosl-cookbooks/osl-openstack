# This file is automatically generated by Chef
# Any changes will be overwritten

[DEFAULT]
<% if @listen_ip && @listen_ip != '*' -%>
bind_host = <%= @listen_ip %>
<% end -%>
enable_v1_api = false
enable_v2_api = true
<% unless @local_storage -%>
enabled_backends = rbd:rbd
show_image_direct_url = true
show_multiple_locations = true
<% else -%>
enabled_backends = file:file
<% end -%>
transport_url = <%= @transport_url %>

[glance_store]
<% unless @local_storage -%>
default_backend = rbd
default_store = rbd
<% else -%>
default_backend = file
default_store = file
<% end -%>

<% unless @local_storage -%>
[rbd]
rbd_store_ceph_conf = /etc/ceph/ceph.conf
rbd_store_chunk_size = 8
rbd_store_pool = <%= @rbd_store_pool %>
rbd_store_user = <%= @rbd_store_user %>
<% else -%>
[file]
filesystem_store_datadir = /var/lib/glance/images
<% end -%>

[paste_deploy]
flavor = keystone

<%= render 'keystone_authtoken.conf.erb', variables: {
  auth_endpoint: @auth_endpoint, memcached_endpoint: @memcached_endpoint, service_pass: @service_pass,
  username: 'glance', v3password: false, region: true
} -%>

<%# heartbeat_in_pthread defaults to True on yoga: the heartbeat stalls for the
    length of an RPC call, so rabbit drops the connection (LP #2035113). -%>
<%= render 'oslo_messaging.conf.erb' -%>

[database]
connection = <%= @database_connection %>
# Recycle pooled connections before osl-mysql's wait_timeout (600s) closes them
connection_recycle_time = 300
