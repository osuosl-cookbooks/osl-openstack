<% p = @template_params -%>
<% backend = "unix:#{p[:socket]}|uwsgi://localhost/" -%>
Listen <%= @server_address %>:<%= p[:port] %>

<VirtualHost <%= @server_address %>:<%= p[:port] %>>
  ErrorLogFormat "%{cu}t %M"

  ErrorLog "|/usr/sbin/rotatelogs <%= @log_dir %>/<%= p[:log_name] %>/error/%Y%m%d.log 86400"
  CustomLog "|/usr/sbin/rotatelogs <%= @log_dir %>/<%= p[:log_name] %>/access/%Y%m%d.log 86400" combined-osuosl

  <Proxy "*">
    Require all granted
  </Proxy>

<% if p[:location_alias] -%>
  ProxyPass <%= p[:location_alias] %> "<%= backend %>" retry=0
  ProxyPassReverse <%= p[:location_alias] %> "<%= backend %>"
<% end -%>
  ProxyPass / "<%= backend %>" retry=0
  ProxyPassReverse / "<%= backend %>"
</VirtualHost>
